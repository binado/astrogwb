# Paper-figure matplotlib style for the astrogwb paper application.
# Load via: from astrogwb.paper.plotting import use_paper_style; use_paper_style()

text.usetex: True
font.family: serif
mathtext.fontset: cm
font.size: 14
axes.labelsize: medium
axes.titlesize: medium
axes.unicode_minus: False
figure.labelsize: medium
figure.titlesize: medium
legend.fontsize: small
legend.title_fontsize: small
legend.frameon: False
xtick.labelsize: small
ytick.labelsize: small
xtick.direction: in
xtick.minor.visible: True
xtick.top: True
ytick.direction: in
ytick.minor.visible: True
ytick.right: True
# Explicitly restore a closed frame. ArviZ styles (e.g. arviz-variat) turn
# these off; paper.mplstyle must override them so density plots match.
axes.spines.top: True
axes.spines.right: True

savefig.dpi: 300
savefig.bbox: tight
savefig.format: pdf

# Colorblind-safe fallback cycle (Okabe-Ito). Comparison figures pass explicit
# colors from the palettes in astrogwb.paper.plotting; this cycle is only the
# default.
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'CC79A7', '56B4E9', 'D55E00', 'F0E442'])
