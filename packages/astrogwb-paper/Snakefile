import re
import shlex
from pathlib import Path

from astrogwb_paper.config.catalogs import (
    INJECTION_CATALOG_NAME,
    load_catalog_inventory,
)
from astrogwb_paper.config.experiments import (
    DEFAULT_CATALOG,
    load_experiments,
)
from astrogwb_paper.plotting import DETECTOR_NETWORK_RUNS


SOURCE_EXPERIMENTS = Path("inputs/experiments.yaml")
SOURCE_CATALOGS = Path("inputs/catalogs.yaml")
JAX_PLATFORM = config.get("jax_platforms", "cuda")
CATALOGS_DIR = Path(config.get("catalogs_dir", "outputs/catalogs"))

CONFIG_PATTERN = "outputs/configs/{experiment}/{run}.json"
CHAIN_PATTERN = "outputs/chains/{experiment}/{run}.nc"

experiments = load_experiments()
catalog_inventory = load_catalog_inventory()
sources = catalog_inventory.sources
injection = catalog_inventory.injection
catalogs = catalog_inventory.catalogs
CONFIG_OUTPUTS = [
    str(specification.merged_config_path(run))
    for specification in experiments.values()
    for run in specification.runs
]
EXPERIMENT_PATTERN = "|".join(re.escape(name) for name in experiments)
CATALOG_PATTERN = "|".join(re.escape(name) for name in catalogs)
SOURCE_PATTERN = "|".join(re.escape(name) for name in sources)
RUN_PATTERN = "|".join(
    re.escape(run)
    for run in dict.fromkeys(
        run for specification in experiments.values() for run in specification.runs
    )
)


def recipe(wildcards):
    return catalogs[wildcards.catalog]


def source_recipe(wildcards):
    return sources[wildcards.source]


def _source_population(name):
    return f"outputs/populations/sources/{name}.h5"


def _production_population(name):
    return f"outputs/populations/production/proposals/{name}.h5"


def _proposal_catalog(name):
    return str(CATALOGS_DIR / "proposals" / f"{name}.h5")


def _injection_catalog():
    return str(CATALOGS_DIR / f"{INJECTION_CATALOG_NAME}.h5")


def run_catalog_path(wildcards):
    return _proposal_catalog(
        experiments[wildcards.experiment].catalog_for(wildcards.run)
    )


def _source_flags(production):
    return " ".join(
        f"--source {shlex.quote(_source_population(component.source))}"
        for component in production.components
    )


def _weight_flags(production):
    return " ".join(
        f"--weight {component.weight}" for component in production.components
    )


def _source_config_flags(production):
    return " ".join(
        f"--source-config {shlex.quote(str(sources[component.source].population_config))}"
        for component in production.components
    )


def run_outdir(wildcards):
    return str(Path("outputs/chains") / wildcards.experiment)


wildcard_constraints:
    catalog=CATALOG_PATTERN,
    source=SOURCE_PATTERN,
    experiment=EXPERIMENT_PATTERN,
    run=RUN_PATTERN,


localrules:
    source_population,
    assemble_injection_population,
    assemble_proposal_population,
    injection_waveform_catalog,
    proposal_waveform_catalog,
    assemble_config,
    plot_cosmological_parameters,
    plot_modified_propagation,
    amplitude_toy,
    fiducial_spectrum,
    importance_weights_grid,
    experiments,


rule source_population:
    input:
        recipe=ancient(str(SOURCE_CATALOGS)),
        population_config=lambda wc: source_recipe(wc).population_config,
    output:
        "outputs/populations/sources/{source}.h5",
    params:
        num_samples=lambda wc: source_recipe(wc).num_samples,
        seed=lambda wc: source_recipe(wc).seed,
        outdir="outputs/populations/sources",
    shell:
        "mkdir -p {params.outdir:q}\n"
        "uv run --package astrogwb-paper gwmock-pop simulate"
        " --config {input.population_config:q}"
        " --n {params.num_samples}"
        " --output {output:q}"
        " --seed {params.seed}"


rule assemble_injection_population:
    input:
        recipe=ancient(str(SOURCE_CATALOGS)),
        sources=lambda wc: [
            _source_population(component.source)
            for component in injection.production.components
        ],
    output:
        f"outputs/populations/production/{INJECTION_CATALOG_NAME}.h5",
    params:
        operation=injection.production.operation,
        num_samples=injection.production.num_samples,
        seed=injection.production.seed,
        source_flags=_source_flags(injection.production),
    shell:
        "uv run --package astrogwb-paper astrogwb-assemble-population"
        " --operation {params.operation:q} {params.source_flags}"
        " --num-samples {params.num_samples} --seed {params.seed}"
        " --output {output:q}"


rule assemble_proposal_population:
    input:
        recipe=ancient(str(SOURCE_CATALOGS)),
        sources=lambda wc: [
            _source_population(component.source)
            for component in recipe(wc).production.components
        ],
        configs=lambda wc: [
            sources[component.source].population_config
            for component in recipe(wc).production.components
        ],
    output:
        "outputs/populations/production/proposals/{catalog}.h5",
    params:
        operation=lambda wc: recipe(wc).production.operation,
        num_samples=lambda wc: recipe(wc).production.num_samples,
        seed=lambda wc: recipe(wc).production.seed,
        epsilon=lambda wc: recipe(wc).production.uniform_redshift_fraction,
        source_flags=lambda wc: _source_flags(recipe(wc).production),
        weight_flags=lambda wc: _weight_flags(recipe(wc).production),
        config_flags=lambda wc: _source_config_flags(recipe(wc).production),
    shell:
        "uv run --package astrogwb-paper astrogwb-assemble-population"
        " --operation {params.operation:q} {params.source_flags} {params.weight_flags}"
        " --num-samples {params.num_samples} --seed {params.seed}"
        " {params.config_flags} --uniform-redshift-fraction {params.epsilon}"
        " --output {output:q}"


rule injection_waveform_catalog:
    input:
        population=f"outputs/populations/production/{INJECTION_CATALOG_NAME}.h5",
        recipe=ancient(str(SOURCE_CATALOGS)),
    output:
        f"outputs/catalogs/{INJECTION_CATALOG_NAME}.h5",
    params:
        approximant=injection.waveform.approximant,
        sampling_frequency=injection.waveform.sampling_frequency,
        minimum_frequency=injection.waveform.minimum_frequency,
        maximum_frequency=injection.waveform.maximum_frequency,
        reference_frequency=injection.waveform.reference_frequency,
        frequency_resolution=injection.waveform.frequency_resolution,
        chunk_size=injection.waveform.chunk_size,
    shell:
        "uv run --package astrogwb-paper astrogwb-generate-waveform-catalog"
        " --population {input.population:q}"
        " --output {output:q}"
        " --approximant {params.approximant:q}"
        " --sampling-frequency {params.sampling_frequency}"
        " --minimum-frequency {params.minimum_frequency}"
        " --maximum-frequency {params.maximum_frequency}"
        " --reference-frequency {params.reference_frequency}"
        " --frequency-resolution {params.frequency_resolution}"
        " --chunk-size {params.chunk_size}"


rule proposal_waveform_catalog:
    input:
        population="outputs/populations/production/proposals/{catalog}.h5",
        recipe=ancient(str(SOURCE_CATALOGS)),
    output:
        "outputs/catalogs/proposals/{catalog}.h5",
    params:
        approximant=lambda wc: recipe(wc).waveform.approximant,
        sampling_frequency=lambda wc: recipe(wc).waveform.sampling_frequency,
        minimum_frequency=lambda wc: recipe(wc).waveform.minimum_frequency,
        maximum_frequency=lambda wc: recipe(wc).waveform.maximum_frequency,
        reference_frequency=lambda wc: recipe(wc).waveform.reference_frequency,
        frequency_resolution=lambda wc: recipe(wc).waveform.frequency_resolution,
        chunk_size=lambda wc: recipe(wc).waveform.chunk_size,
    shell:
        "uv run --package astrogwb-paper astrogwb-generate-waveform-catalog"
        " --population {input.population:q}"
        " --output {output:q}"
        " --approximant {params.approximant:q}"
        " --sampling-frequency {params.sampling_frequency}"
        " --minimum-frequency {params.minimum_frequency}"
        " --maximum-frequency {params.maximum_frequency}"
        " --reference-frequency {params.reference_frequency}"
        " --frequency-resolution {params.frequency_resolution}"
        " --chunk-size {params.chunk_size}"


rule assemble_config:
    input:
        config=str(SOURCE_EXPERIMENTS),
    output:
        CONFIG_OUTPUTS,
    shell:
        "uv run --package astrogwb-paper astrogwb-validate-config"
        " {input.config:q} --output-dir outputs/configs"


rule run_mcmc:
    input:
        config=ancient(CONFIG_PATTERN),
        injection_catalog=_injection_catalog(),
        proposal_catalog=run_catalog_path,
    output:
        chain=protected(CHAIN_PATTERN),
    params:
        platform=JAX_PLATFORM,
        outdir=run_outdir,
    threads: 4
    resources:
        mem_mb=8000,
        runtime=720,
    shell:
        """
        export INPUT="*"
        export OUTPUT="*"
        NANNY=
        if command -v job-nanny >/dev/null 2>&1; then
            NANNY=job-nanny
        fi
        if [ "{params.platform}" = "cpu" ]; then
            RUNTIME_FLAGS="--host-device-count {threads} --cpu-threads 1"
            UV_EXTRAS="--package astrogwb-paper"
        else
            RUNTIME_FLAGS="--cpu-threads {threads}"
            UV_EXTRAS="--package astrogwb-paper --extra cuda"
        fi
        $NANNY uv run $UV_EXTRAS astrogwb-run-mcmc \
            --config {input.config:q} --outdir {params.outdir:q} \
            --label {wildcards.run:q} \
            --injection-catalog {input.injection_catalog:q} \
            --proposal-catalog {input.proposal_catalog:q} \
            --platform {params.platform:q} $RUNTIME_FLAGS --force
        """


rule plot_cosmological_parameters:
    input:
        # Legend order comes from plotting.DETECTOR_NETWORKS, which the
        # script reads too -- one list, so chain and label order cannot drift.
        detector_chains=expand(
            "outputs/chains/cosmological-parameters/{run}.nc",
            run=DETECTOR_NETWORK_RUNS,
        ),
        # The fixed-R0 reference reuses the ET-2L-aligned-CE-Hanford chain,
        # whose run pins local_merger_rate to its fiducial; the comparison
        # chain samples local_merger_rate with H0 amplitude-marginalized.
        prior_chains=expand(
            "outputs/chains/cosmological-parameters/{run}.nc",
            run=["ET-2L-aligned-CE-Hanford", "H0-merger-rate"],
        ),
        omega_m_chain="outputs/chains/cosmological-parameters/H0-Omega_m.nc",
        catalog=_injection_catalog(),
        config=str(SOURCE_EXPERIMENTS),
    output:
        detector_pdf="outputs/figures/cosmological-parameters/H0-by-detector.pdf",
        detector_csv="outputs/figures/cosmological-parameters/H0-by-detector.csv",
        detector_tex="outputs/figures/cosmological-parameters/H0-by-detector.tex",
        prior_pdf="outputs/figures/cosmological-parameters/H0-merger-rate-priors.pdf",
        merger_rate_corner_pdf=(
            "outputs/figures/cosmological-parameters/H0-merger-rate-corner.pdf"
        ),
        merger_rate_csv="outputs/figures/cosmological-parameters/H0-merger-rate.csv",
        merger_rate_tex="outputs/figures/cosmological-parameters/H0-merger-rate.tex",
        omega_m_corner_pdf="outputs/figures/cosmological-parameters/H0-Omega_m-corner.pdf",
        omega_m_ess_corner_pdf=(
            "outputs/figures/cosmological-parameters/H0-Omega_m-ess-corner.pdf"
        ),
    shell:
        "uv run --package astrogwb-paper --group plotting"
        " python scripts/mcmc_cosmological_parameters.py"
        " --catalog {input.catalog:q}"
        " --detector-chains {input.detector_chains:q}"
        " --prior-chains {input.prior_chains:q}"
        " --omega-m-chain {input.omega_m_chain:q}"
        " --output-detector-pdf {output.detector_pdf:q}"
        " --output-detector-csv {output.detector_csv:q}"
        " --output-detector-tex {output.detector_tex:q}"
        " --output-prior-pdf {output.prior_pdf:q}"
        " --output-narrow-corner-pdf {output.merger_rate_corner_pdf:q}"
        " --output-merger-rate-csv {output.merger_rate_csv:q}"
        " --output-merger-rate-tex {output.merger_rate_tex:q}"
        " --output-omega-m-corner-pdf {output.omega_m_corner_pdf:q}"
        " --output-omega-m-ess-corner-pdf {output.omega_m_ess_corner_pdf:q}"


rule plot_modified_propagation:
    input:
        xi0_chain="outputs/chains/modified-propagation/Xi_0.nc",
        xi0_n_chain=(
            "outputs/chains/modified-propagation"
            "/ET-2L-aligned-CE-Hanford.nc"
        ),
        h0_chain="outputs/chains/modified-propagation/Xi_0-H0.nc",
        detector_chains=expand(
            "outputs/chains/modified-propagation/{run}.nc",
            run=DETECTOR_NETWORK_RUNS,
        ),
        catalog=_injection_catalog(),
        config=str(SOURCE_EXPERIMENTS),
    output:
        xi_n_corner_pdf="outputs/figures/modified-propagation/Xi0-n-corner.pdf",
        xi_n_ess_corner_pdf="outputs/figures/modified-propagation/Xi0-n-ess-corner.pdf",
        xi0_marginal_pdf="outputs/figures/modified-propagation/Xi0-marginal.pdf",
        h0_corner_pdf="outputs/figures/modified-propagation/Xi0-H0-corner.pdf",
        csv="outputs/figures/modified-propagation/Xi0-n-by-detector.csv",
        tex="outputs/figures/modified-propagation/Xi0-n-by-detector.tex",
    shell:
        "uv run --package astrogwb-paper --group plotting"
        " python scripts/mcmc_modified_propagation.py"
        " --xi0-chain {input.xi0_chain:q} --xi0-n-chain {input.xi0_n_chain:q}"
        " --h0-chain {input.h0_chain:q}"
        " --detector-xi0-n-chains {input.detector_chains:q}"
        " --catalog {input.catalog:q}"
        " --output-xi-n-corner-pdf {output.xi_n_corner_pdf:q}"
        " --output-xi-n-ess-corner-pdf {output.xi_n_ess_corner_pdf:q}"
        " --output-xi0-marginal-pdf {output.xi0_marginal_pdf:q}"
        " --output-h0-corner-pdf {output.h0_corner_pdf:q}"
        " --output-xi0-n-csv {output.csv:q} --output-xi0-n-tex {output.tex:q}"


rule amplitude_toy:
    input:
        catalog=_injection_catalog(),
        config=str(SOURCE_EXPERIMENTS),
    output:
        "outputs/figures/standalone/amplitude_toy_fisher_overlay.pdf",
    shell:
        "uv run --package astrogwb-paper --group plotting"
        " python scripts/amplitude_toy_model.py"
        " --catalog {input.catalog:q}"
        " --chains-dir outputs/chains/amplitude-toy"
        " --output-pdf {output:q}"


rule fiducial_spectrum:
    input:
        catalog=_injection_catalog(),
        # Borrows the cosmological-parameters networks; reads no chains.
        config=str(SOURCE_EXPERIMENTS),
    output:
        spectrum_pdf="outputs/figures/standalone/fiducial_spectrum.pdf",
        effective_psd_pdf=(
            "outputs/figures/standalone/fiducial_effective_psd_by_detector.pdf"
        ),
    shell:
        "uv run --package astrogwb-paper --group plotting"
        " python scripts/fiducial_spectrum.py"
        " --catalog {input.catalog:q}"
        " --output-pdf {output.spectrum_pdf:q}"
        " --output-effective-psd-pdf {output.effective_psd_pdf:q}"


rule importance_weights_grid:
    input:
        catalog=_proposal_catalog(DEFAULT_CATALOG),
        config=str(SOURCE_EXPERIMENTS),
    output:
        h0_omega_m_pdf=(
            "outputs/figures/standalone/importance_weights_grid_H0_Omega_m.pdf"
        ),
        xi0_n_pdf="outputs/figures/standalone/importance_weights_grid_Xi0_n.pdf",
    shell:
        "uv run --package astrogwb-paper --group plotting"
        " python scripts/importance_weights_grid.py"
        " --catalog {input.catalog:q}"
        " --output-h0-omega-m-pdf {output.h0_omega_m_pdf:q}"
        " --output-xi0-n-pdf {output.xi0_n_pdf:q}"


# These aggregate targets read rules.* outputs, so they must follow the rules
# they reference. An experiment with a figure rule is complete when that rule
# has run; one without is complete when its chains exist.
FIGURE_OUTPUTS = {
    "cosmological-parameters": list(rules.plot_cosmological_parameters.output),
    "modified-propagation": list(rules.plot_modified_propagation.output),
}
EXPERIMENT_OUTPUTS = [
    path
    for specification in experiments.values()
    for path in (FIGURE_OUTPUTS.get(specification.name) or specification.chain_paths())
]


rule experiments:
    input:
        EXPERIMENT_OUTPUTS,


for specification in experiments.values():

    rule:
        name: specification.chains_target
        localrule: True
        input:
            specification.chain_paths(),

    rule:
        name: specification.target
        localrule: True
        input:
            FIGURE_OUTPUTS.get(specification.name) or specification.chain_paths(),
